---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/site';

const destinations = [
  { name: "Visakhapatnam (Vizag)", desc: "Scenic coastal getaways, pristine beaches, and city heritage tours." },
  { name: "Araku Valley", desc: "Mist-clad coffee plantations, waterfalls, and mesmerizing valley views." },
  { name: "Lambasingi", desc: "Andhra's Kashmir—experience chilly weather, foggy hills, and serene nature." },
  { name: "More Destinations", desc: "Customized holiday packages tailored to your dream destinations." }
];
---

<Layout title={`${siteConfig.name} - Coming Soon | Tours & Travels`}>
  <main class="min-h-screen bg-slate-900 text-slate-100 flex flex-col justify-between selection:bg-teal-500 selection:text-white">

    <!-- Top Corporate Header / Tribute Bar -->
    <header class="w-full border-b border-slate-800 bg-slate-950/60 backdrop-blur-md py-4 px-6 md:px-12">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
        <div class="flex items-center gap-3">
          <span class="text-xl font-bold tracking-wider text-teal-400">MEETRIP</span>
          <span class="hidden sm:inline text-slate-600">|</span>
          <span class="text-xs uppercase tracking-widest text-slate-400 font-medium">Tours & Travels</span>
        </div>
        <div class="text-xs italic text-slate-400 tracking-wide">
          ✨ {siteConfig.tribute}
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="max-w-5xl mx-auto px-6 py-16 md:py-24 text-center">

      <!-- Coming Soon Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-400 text-xs font-semibold uppercase tracking-widest mb-8 animate-pulse">
        <span class="w-2 h-2 rounded-full bg-teal-400"></span>
        Coming Soon
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight">
        Discover the Wonders of <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-cyan-400">Nature & Heritage</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto mb-12 font-light leading-relaxed">
        We are crafting exceptional travel experiences across <strong class="text-white font-normal">Vizag, Araku, Lambasingi</strong>, and beyond. Premium corporate and leisure travel planning designed just for you.
      </p>

      <!-- Destination Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-left mb-16">
        {destinations.map((item) => (
          <div class="p-6 rounded-2xl bg-slate-800/50 border border-slate-700/60 hover:border-teal-500/50 transition-all duration-300 group">
            <h3 class="text-lg font-semibold text-white mb-2 group-hover:text-teal-400 transition-colors">{item.name}</h3>
            <p class="text-sm text-slate-400 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <!-- Stay Connected / Call To Action Box -->
      <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-b from-slate-800/80 to-slate-900 border border-slate-700/80 shadow-2xl max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-3">Stay Connected With Us</h2>
        <p class="text-slate-400 text-sm mb-6">
          Be the first to know when we launch our booking portal and exclusive tour packages.
        </p>

        <!-- Contact Links -->
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4 text-sm font-medium">
          <a href={`mailto:${siteConfig.email}`} class="flex items-center gap-2 px-6 py-3 rounded-xl bg-teal-500 hover:bg-teal-400 text-slate-950 font-semibold transition-all shadow-lg shadow-teal-500/20">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            {siteConfig.email}
          </a>

          <a href={`tel:${siteConfig.phone}`} class="flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 transition-all">
            <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            +91 {siteConfig.phone}
          </a>
        </div>
      </div>

    </section>

    <!-- Footer -->
    <footer class="py-8 px-6 text-center border-t border-slate-800 text-xs text-slate-500">
      <p>&copy; {new Date().getFullYear()} MeeTrip Tours & Travels. All rights reserved.</p>
    </footer>

  </main>
</Layout>